+void nova_setup_posuv_fixed_color(void *base, int stride) {
+    /* Sentinel -3 identifies pos3f/uv2f/fixed-color and is distinct from the
+     * packed 24-byte (- ordinary 3) and lit (-4) layouts. */
+    if (s_attr_pos_elements != -3) {
+        AttrInfo_Init(&g.attr_info);
+        AttrInfo_AddLoader(&g.attr_info, 0, GPU_FLOAT, 3);
+        AttrInfo_AddLoader(&g.attr_info, 1, GPU_FLOAT, 2);
+        AttrInfo_AddFixed(&g.attr_info, 2);
+        C3D_SetAttrInfo(&g.attr_info);
+        s_attr_pos_elements = -3;
+    }
+    if (s_buf_base != base || s_buf_stride != stride || s_buf_layout != 2) {
+        C3D_BufInfo *bufInfo = C3D_GetBufInfo();
+        BufInfo_Init(bufInfo);
+        BufInfo_Add(bufInfo, base, stride, 2, 0x10);
+        s_buf_base = base;
+        s_buf_stride = stride;
+        s_buf_layout = 2;
+    }
