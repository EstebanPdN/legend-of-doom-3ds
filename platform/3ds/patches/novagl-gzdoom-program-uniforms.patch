+/* GLSL uniforms belong to a program.  GZDoom relies on that rule and keeps a
+ * separate CPU-side uniform cache for every shader variant.  The original
+ * compatibility bridge returned program id 1 for every glCreateProgram and
+ * ignored glUseProgram, which collapsed all of those caches into one global
+ * state.  A sky shader could therefore leave its blue uObjectColor active;
+ * the world shader quite correctly skipped re-uploading its already-cached
+ * white value, and the entire floor inherited the sky tint.
+ *
+ * Only uniforms mapped to NovaGL global/fixed-function state need snapshots.
+ * Matrices and uClipLine are unbuffered by GZDoom and are uploaded on every
+ * Apply, so they do not need to be duplicated here. */
+#define GZD_MAX_PROGRAMS 1024
+typedef struct {
+    int in_use;
+    GLfloat object_color[4];
+    GLfloat add_color[4];
+    GLfloat fog_color[4];
+    GLfloat alpha_threshold;
+    GLfloat clip_height;
+    GLfloat clip_height_direction;
+} GzdProgramState;
+
+static GzdProgramState gzd_programs[GZD_MAX_PROGRAMS];
+static GLuint gzd_next_program = 1;
+static GLuint gzd_active_program = 0;
+
+static GzdProgramState *gzd_current_program_state(void)
+{
+    if (gzd_active_program == 0 || gzd_active_program >= GZD_MAX_PROGRAMS ||
+        !gzd_programs[gzd_active_program].in_use)
+        return NULL;
+    return &gzd_programs[gzd_active_program];
+}
+
+GLuint glCreateProgram(void)
+{
+    if (gzd_next_program >= GZD_MAX_PROGRAMS) {
+        gl_set_error(GL_OUT_OF_MEMORY);
+        return 0;
+    }
+    GLuint program = gzd_next_program++;
+    memset(&gzd_programs[program], 0, sizeof(gzd_programs[program]));
+    gzd_programs[program].in_use = 1;
+    return program;
+}
+
+void glDeleteProgram(GLuint program)
+{
+    if (program == 0 || program >= GZD_MAX_PROGRAMS) return;
+    /* GZDoom does not draw a program after deleting it.  Keep an active
+     * program alive until another one is bound, matching GL's deferred delete
+     * behaviour closely enough for this fixed-function bridge. */
+    if (program != gzd_active_program)
+        memset(&gzd_programs[program], 0, sizeof(gzd_programs[program]));
+}
