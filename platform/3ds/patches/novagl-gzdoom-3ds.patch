@@ -220,13 +220,30 @@ void apply_gpu_state(void);
  * an empty command list raises none, and waiting on it deadlocks). The
  * function-like macros below shadow the citro3d names inside NovaGL only;
  * the parenthesised calls inside the shims bypass macro expansion. */
+static inline void nova_cmd_buffer_guard_(void)
+{
+    /* GZDoom can issue several thousand small world draws in one frame.  A
+     * single 512 KiB citro3d command list is not large enough for MAP01, and
+     * GPUCMD_Add deliberately panics instead of overflowing it.  Split while
+     * there is still ample room for C3Di_UpdateContext plus the draw packet.
+     * C3D_FrameSplit preserves PICA state and draw order; it only starts a new
+     * command list inside the same logical frame. */
+    /* C3D_GetCmdBufUsage() is updated when a list is submitted; it is not the
+     * live fill level while the CPU is still appending commands.  The libctru
+     * globals are the authoritative word offset/capacity for that purpose. */
+    if (gpuCmdBufSize && gpuCmdBufOffset >= (gpuCmdBufSize * 3u) / 4u)
+        C3D_FrameSplit(0);
+}
+
 static inline void nova_c3d_draw_arrays_(GPU_Primitive_t primitive, int first, int size)
 {
+    nova_cmd_buffer_guard_();
     g.p3d_pending = 1;
     (C3D_DrawArrays)(primitive, first, size);
 }
 static inline void nova_c3d_draw_elements_(GPU_Primitive_t primitive, int count, int type, const void* indices)
 {
+    nova_cmd_buffer_guard_();
