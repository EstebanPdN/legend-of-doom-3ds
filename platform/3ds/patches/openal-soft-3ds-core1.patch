diff --git a/alc/backends/ndsp_driver.cpp b/alc/backends/ndsp_driver.cpp
index ff1e4220..a66b4892 100644
--- a/alc/backends/ndsp_driver.cpp
+++ b/alc/backends/ndsp_driver.cpp
@@ -45,6 +45,9 @@ struct AlcNdspStream {
     LightEvent mEvent{};
     Thread mThread{nullptr};
     std::atomic<bool> mKillNow{true};
+
+    u32 mPreviousCpuLimit{};
+    bool mRaisedCpuLimit{false};
 };

 namespace {
@@ -155,11 +158,41 @@ void alcNdspStart(AlcNdspStream *const stream)

     s32 prio{0x30};
     svcGetThreadPriority(&prio, CUR_THREAD_HANDLE);
-    stream->mThread = threadCreate(mixerThreadEntry, stream, 32*1024, prio-1, -1, false);
+
+    int core{-1};
+    u32 previousCpuLimit{};
+    if(R_SUCCEEDED(APT_GetAppCpuTimeLimit(&previousCpuLimit)))
+    {
+        stream->mPreviousCpuLimit = previousCpuLimit;
+        if(previousCpuLimit >= 30)
+            core = 1;
+        else if(R_SUCCEEDED(APT_SetAppCpuTimeLimit(30)))
+        {
+            stream->mRaisedCpuLimit = true;
+            core = 1;
+        }
+    }
+
+    stream->mThread = threadCreate(mixerThreadEntry, stream, 32*1024, prio-1, core, false);
+    if(!stream->mThread && core == 1)
+    {
+        if(stream->mRaisedCpuLimit)
+        {
+            APT_SetAppCpuTimeLimit(stream->mPreviousCpuLimit);
+            stream->mRaisedCpuLimit = false;
+        }
+        stream->mThread = threadCreate(mixerThreadEntry, stream, 32*1024, prio-1, -1, false);
+    }
+
     if(!stream->mThread)
     {
         stream->mKillNow.store(true, std::memory_order_release);
         ndspSetCallback(nullptr, nullptr);
+        if(stream->mRaisedCpuLimit)
+        {
+            APT_SetAppCpuTimeLimit(stream->mPreviousCpuLimit);
+            stream->mRaisedCpuLimit = false;
+        }
     }
 }

