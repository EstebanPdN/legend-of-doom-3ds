 void apply_gpu_state(void);

+#if defined(__3DS__) && defined(NOVAGL_HARDWARE_STAGE_LOG) && NOVAGL_HARDWARE_STAGE_LOG
+/* First-frame hardware supervisor. It submits each draw as an isolated
+ * Citro3D command list and waits on Citro3D's own GX queue with a deadline.
+ * A wedged PICA command therefore produces a persistent report and terminates
+ * the process instead of parking forever inside C3D_FrameBegin. */
+void nova_hw_watchdog_reset(void);
+void nova_hw_watchdog_before_draw(int primitive, int first, int count,
+                                  int indexed, int index_type,
+                                  const void *indices);
+void nova_hw_watchdog_after_draw(void);
+void nova_hw_watchdog_frame_split(unsigned flags, const char *file, int line);
+int nova_hw_watchdog_frame_begin(unsigned flags);
+
+static inline void nova_c3d_frame_split_(unsigned flags,
+                                         const char *file, int line)
+{
+    nova_hw_watchdog_frame_split(flags, file, line);
+}
+#define C3D_FrameSplit(flags) \
+    nova_c3d_frame_split_((flags), __FILE__, __LINE__)
+#endif
+

