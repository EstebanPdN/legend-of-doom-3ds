diff --git a/shaders/NovaGL_shader_clipspace.pica b/shaders/NovaGL_shader_clipspace.pica
--- a/shaders/NovaGL_shader_clipspace.pica
+++ b/shaders/NovaGL_shader_clipspace.pica
@@ -32,6 +32,7 @@
 .out outTexcoord1  texcoord1

 .constf CONST1 (1.0, 0.0, 0.0, 0.0)
+.constf TEXW (0.0, 0.0, 0.0, 1.0)
 .constf my_normalize (0.00392156, 0.00392156, 0.00392156, 0.00392156)

 .proc main
@@ -64,13 +65,15 @@
     mov outColor, r1

     ; UV passthrough — texcoord loader is 2 floats, PICA pads to (s, t, 0, 1).
-    mov outTexcoord0, inTexcoord
+    mov outTexcoord0.xy, inTexcoord.xy
+    mov outTexcoord0.zw, TEXW.zw
     ; PICA texture unit 1 samples with TEXCOORD1, which is a separate
     ; interpolant — without writing it, any TEV stage referencing
     ; GPU_TEXTURE1 (fast3d TRILERP mip blends) samples with garbage
     ; coordinates. Mirror unit 0's UV; N64 mip levels share normalized
     ; coordinates, so this matches what the RDP did.
-    mov outTexcoord1, inTexcoord
+    mov outTexcoord1.xy, inTexcoord.xy
+    mov outTexcoord1.zw, TEXW.zw

     end
 .end
