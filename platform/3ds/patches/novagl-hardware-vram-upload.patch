+/* Partial CPU updates cannot target VRAM directly. Preserve the tiled image
+ * with a synchronous raw GX copy, then continue the update in linear RAM. */
+static int ensure_texture_cpu_writable(TexSlot *slot) {
+    if (!slot || !slot->allocated || !slot->tex.data) return 0;
+    if (!texture_data_is_vram(slot->tex.data)) return 1;
+
+    C3D_TexInitParams params;
+    memset(&params, 0, sizeof(params));
+    params.width = slot->tex.width;
+    params.height = slot->tex.height;
+    params.maxLevel = slot->tex.maxLevel;
+    params.format = slot->fmt;
+    params.type = GPU_TEX_2D;
+    params.onVram = false;
+
+    C3D_Tex linear_tex;
+    memset(&linear_tex, 0, sizeof(linear_tex));
+    if (!C3D_TexInitWithParams(&linear_tex, NULL, params)) {
+        gl_set_error(GL_OUT_OF_MEMORY);
+        return 0;
+    }
+
+    const u32 bytes = slot->tex.maxLevel > 0
+        ? C3D_TexCalcTotalSize((u32)slot->tex.size, slot->tex.maxLevel)
+        : (u32)slot->tex.size;
+    C3D_SyncTextureCopy((u32 *)slot->tex.data, 0, (u32 *)linear_tex.data, 0,
+                        bytes, GX_TRANSFER_RAW_COPY(1));
+    GSPGPU_InvalidateDataCache(linear_tex.data, bytes);
+
+    nova_tex_gc_push(&slot->tex);
+    slot->tex = linear_tex;
+    slot->is_vram = 0;
+    nova_invalidate_tex_bind((GLuint)(slot - g.textures));
+    apply_slot_params_to_tex(&slot->tex, slot);
+    return 1;
+}
