+/* VRAM uploads are staged in a bounded linear buffer before GX copies them. */
+#define NOVA_VRAM_UPLOAD_MAX (1024 * 1024)
+
+static int texture_data_is_vram(const void *data) {
+    const uintptr_t address = (uintptr_t)data;
+    return address >= 0x1f000000u && address < 0x1f600000u;
+}
+
+static int zero_texture_storage_safe(C3D_Tex *tex) {
+    if (!tex || !tex->data || tex->size == 0) return 1;
+    const size_t bytes = tex->maxLevel > 0
+        ? (size_t)C3D_TexCalcTotalSize((u32)tex->size, tex->maxLevel)
+        : (size_t)tex->size;
+    if (!texture_data_is_vram(tex->data)) {
+        memset(tex->data, 0, bytes);
+        GSPGPU_FlushDataCache(tex->data, (u32)bytes);
+        return 1;
+    }
+    if (bytes > NOVA_VRAM_UPLOAD_MAX) return 0;
+    void *staging = get_tex_staging((int)bytes);
+    if (!staging) return 0;
+    memset(staging, 0, bytes);
+    GSPGPU_FlushDataCache(staging, (u32)bytes);
+    C3D_TexLoadImage(tex, staging, GPU_TEXFACE_2D, -1);
+    return 1;
+}
