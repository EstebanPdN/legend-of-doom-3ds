+static void nova_modelv_triangle_at(GLenum mode, const NovaModelV *vin,
+                                    int triangle, NovaModelV out[3]) {
+    if (mode == GL_TRIANGLES) {
+        out[0] = vin[triangle * 3 + 0];
+        out[1] = vin[triangle * 3 + 1];
+        out[2] = vin[triangle * 3 + 2];
+    } else if (mode == GL_TRIANGLE_FAN) {
+        out[0] = vin[0];
+        out[1] = vin[triangle + 1];
+        out[2] = vin[triangle + 2];
+    } else if (mode == GL_TRIANGLE_STRIP) {
+        if ((triangle & 1) == 0) {
+            out[0] = vin[triangle];
+            out[1] = vin[triangle + 1];
+        } else {
+            out[0] = vin[triangle + 1];
+            out[1] = vin[triangle];
+        }
+        out[2] = vin[triangle + 2];
+    } else { /* GL_QUADS: (0,1,2) and (0,2,3) per group. */
+        int q = (triangle / 2) * 4;
+        out[0] = vin[q];
+        out[1] = vin[q + ((triangle & 1) ? 2 : 1)];
+        out[2] = vin[q + ((triangle & 1) ? 3 : 2)];
+    }
+}
