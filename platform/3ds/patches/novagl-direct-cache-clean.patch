+/* Route every existing CPU->PICA/GX clean through the direct process-cache
+ * SVC without duplicating changes across NovaGL's upload paths. The original
+ * GSP service remains a runtime fallback inside nova_clean_data_cache. */
+Result nova_clean_data_cache(const void *address, u32 size);
+#ifndef NOVAGL_KEEP_GSP_CACHE_FLUSH
+#define GSPGPU_FlushDataCache(address, size) \
+    nova_clean_data_cache((address), (u32)(size))
+#endif
