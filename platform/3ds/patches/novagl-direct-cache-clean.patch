diff --git a/src/utils.c b/src/utils.c
--- a/src/utils.c
+++ b/src/utils.c
@@ -13,6 +13,30 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <limits.h>
+
+/* CPU-written linear buffers only need their dirty cache lines cleaned before
+ * PICA/GX reads them. GSPGPU_FlushDataCache performs synchronous IPC to the
+ * GSP sysmodule, adding latency and competing with GX retirement on core 1.
+ * PR 26 of zelda-tmc-3ds measured that round trip at roughly 0.33 ms/call on
+ * Old 3DS. Use the direct clean-only SVC and retain the original service call
+ * for 3DSX launchers/exheaders that do not permit syscall 0x53. */
+static int s_nova_cache_clean_mode; /* 0 unprobed, 1 direct, 2 fallback */
+
+Result nova_clean_data_cache(const void *address, u32 size) {
+    if (!address || size == 0) return 0;
+    if (s_nova_cache_clean_mode != 2) {
+        Result result = svcStoreProcessDataCache(CUR_PROCESS_HANDLE,
+            (u32)(uintptr_t)address, size);
+        if (R_SUCCEEDED(result)) {
+            s_nova_cache_clean_mode = 1;
+            return result;
+        }
+        s_nova_cache_clean_mode = 2;
+    }
+
+    /* Parentheses intentionally bypass utils.h's function-like macro. */
+    return (GSPGPU_FlushDataCache)(address, size);
+}
 
