diff --git a/source/decoder/minimp3_decoder.h b/source/decoder/minimp3_decoder.h
new file mode 100644
index 0000000..05e4bba
--- /dev/null
+++ b/source/decoder/minimp3_decoder.h
@@ -0,0 +1,45 @@
+#ifndef MINIMP3_DECODER_H
+#define MINIMP3_DECODER_H
+
+#include "zmusic/sounddecoder.h"
+
+#ifdef HAVE_MINIMP3
+
+// The decoder only uses MusicIO callbacks; no host stdio API is needed.
+#define MINIMP3_NO_STDIO
+#define MINIMP3_ONLY_MP3
+#include "minimp3_ex.h"
+
+struct MiniMP3Decoder : public SoundDecoder
+{
+	virtual void getInfo(int* samplerate, ChannelConfig* chans, SampleType* type) override;
+
+	virtual size_t read(char* buffer, size_t bytes) override;
+	virtual bool seek(size_t offset, bool ms, bool mayrestart) override;
+	virtual size_t getSampleOffset() override;
+	virtual size_t getSampleLength() override;
+
+	MiniMP3Decoder() = default;
+	MiniMP3Decoder(const MiniMP3Decoder& rhs) = delete;
+	MiniMP3Decoder& operator=(const MiniMP3Decoder& rhs) = delete;
+
+	virtual ~MiniMP3Decoder();
+
+protected:
+	virtual bool open(MusicIO::FileInterface* reader) override;
+
+private:
+	mp3dec_ex_t Decoder{};
+	mp3dec_io_t IO{};
+	MusicIO::FileInterface* Reader = nullptr;
+	bool Opened = false;
+	int SampleRate = 0;
+	int Channels = 0;
+
+	static size_t fileRead(void* buffer, size_t bytes, void* user_data);
+	static int fileSeek(uint64_t position, void* user_data);
+};
+
+#endif
+
+#endif /* MINIMP3_DECODER_H */
diff --git a/source/decoder/minimp3_decoder.cpp b/source/decoder/minimp3_decoder.cpp
new file mode 100644
index 0000000..85d2a6a
--- /dev/null
+++ b/source/decoder/minimp3_decoder.cpp
@@ -0,0 +1,116 @@
+/*
+** minimp3_decoder.cpp
+** Lightweight MP3 decoder backed by lieff/minimp3 (CC0-1.0).
+*/
+
+#define MINIMP3_IMPLEMENTATION
+#include "minimp3_decoder.h"
+
+#ifdef HAVE_MINIMP3
+
+#include <algorithm>
+#include <limits>
+
+size_t MiniMP3Decoder::fileRead(void* buffer, size_t bytes, void* user_data)
+{
+	auto decoder = static_cast<MiniMP3Decoder*>(user_data);
+	const size_t request = std::min(bytes,
+		static_cast<size_t>(std::numeric_limits<int32_t>::max()));
+	const long got = decoder->Reader->read(buffer, static_cast<int32_t>(request));
+	return got > 0 ? static_cast<size_t>(got) : 0;
+}
+
+int MiniMP3Decoder::fileSeek(uint64_t position, void* user_data)
+{
+	auto decoder = static_cast<MiniMP3Decoder*>(user_data);
+	if (position > static_cast<uint64_t>(std::numeric_limits<long>::max()))
+		return -1;
+	return decoder->Reader->seek(static_cast<long>(position), SEEK_SET) == 0 ? 0 : -1;
+}
+
+MiniMP3Decoder::~MiniMP3Decoder()
+{
+	if (Opened)
+		mp3dec_ex_close(&Decoder);
+	Opened = false;
+
+	if (Reader)
+		Reader->close();
+	Reader = nullptr;
+}
+
+bool MiniMP3Decoder::open(MusicIO::FileInterface* reader)
+{
+	Reader = reader;
+	IO.read = fileRead;
+	IO.read_data = this;
+	IO.seek = fileSeek;
+	IO.seek_data = this;
+
+	const int result = mp3dec_ex_open_cb(&Decoder, &IO, MP3D_SEEK_TO_SAMPLE);
+	if (result == 0)
+	{
+		SampleRate = Decoder.info.hz;
+		Channels = Decoder.info.channels;
+		if (SampleRate > 0 && (Channels == 1 || Channels == 2))
+		{
+			Opened = true;
+			return true;
+		}
+	}
+
+	// open_cb may allocate its streaming buffer before discovering an error.
+	mp3dec_ex_close(&Decoder);
+	Reader = nullptr; // Return ownership to CreateDecoder so it can try another format.
+	return false;
+}
+
+void MiniMP3Decoder::getInfo(int* samplerate, ChannelConfig* chans, SampleType* type)
+{
+	*samplerate = SampleRate;
+	*chans = Channels == 2 ? ChannelConfig_Stereo : ChannelConfig_Mono;
+	*type = SampleType_Int16;
+}
+
+size_t MiniMP3Decoder::read(char* buffer, size_t bytes)
+{
+	const size_t sampleCount = bytes / sizeof(mp3d_sample_t);
+	const size_t samplesRead = mp3dec_ex_read(&Decoder,
+		reinterpret_cast<mp3d_sample_t*>(buffer), sampleCount);
+	return samplesRead * sizeof(mp3d_sample_t);
+}
+
+bool MiniMP3Decoder::seek(size_t offset, bool ms, bool /*mayrestart*/)
+{
+	uint64_t frameOffset = static_cast<uint64_t>(offset);
+	if (ms)
+	{
+		if (frameOffset > std::numeric_limits<uint64_t>::max() /
+			static_cast<uint64_t>(SampleRate))
+			return false;
+		frameOffset = frameOffset * static_cast<uint64_t>(SampleRate) / 1000u;
+	}
+
+	if (frameOffset > std::numeric_limits<uint64_t>::max() /
+		static_cast<uint64_t>(Channels))
+		return false;
+	return mp3dec_ex_seek(&Decoder, frameOffset * static_cast<uint64_t>(Channels)) == 0;
+}
+
+size_t MiniMP3Decoder::getSampleOffset()
+{
+	const uint64_t frames = Decoder.cur_sample / static_cast<uint64_t>(Channels);
+	return frames > static_cast<uint64_t>(std::numeric_limits<size_t>::max())
+		? std::numeric_limits<size_t>::max()
+		: static_cast<size_t>(frames);
+}
+
+size_t MiniMP3Decoder::getSampleLength()
+{
+	const uint64_t frames = Decoder.samples / static_cast<uint64_t>(Channels);
+	return frames > static_cast<uint64_t>(std::numeric_limits<size_t>::max())
+		? std::numeric_limits<size_t>::max()
+		: static_cast<size_t>(frames);
+}
+
+#endif
