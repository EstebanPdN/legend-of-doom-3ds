+#if defined(__3DS__) && defined(NOVAGL_HARDWARE_STAGE_LOG) && NOVAGL_HARDWARE_STAGE_LOG
+static const char *s_nova_hw_stage_path =
+    "sdmc:/3ds/legend-of-doom/novagl-stage.log";
+
+static void nova_hw_stage_reset(void)
+{
+    FILE *f = fopen(s_nova_hw_stage_path, "w");
+    if (!f) return;
+    fprintf(f, "NovaGL hardware swap stages v1\n");
+    fflush(f);
+    fclose(f);
+}
+
+static void nova_hw_stage(const char *stage, float cmd_usage)
+{
+    FILE *f = fopen(s_nova_hw_stage_path, "a");
+    if (!f) return;
+    fprintf(f, "%llu %s cmd_usage=%.6f\n",
+            (unsigned long long)osGetTime(),
+            stage ? stage : "(null)", (double)cmd_usage);
+    fflush(f);
+    fclose(f);
+}
+#else
+static void nova_hw_stage_reset(void)
+{
+}
+
+static void nova_hw_stage(const char *stage, float cmd_usage)
+{
+    (void)stage;
+    (void)cmd_usage;
+}
+#endif
