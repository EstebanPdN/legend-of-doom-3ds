diff --git a/alc/backends/ndsp.cpp b/alc/backends/ndsp.cpp
--- a/alc/backends/ndsp.cpp
+++ b/alc/backends/ndsp.cpp
@@ -113,7 +113,7 @@ auto NdspBackend::reset() -> bool
     mDevice->mSampleRate = std::clamp(mDevice->mSampleRate, 8000u, 48000u);
 
     mFrameStep = mDevice->channelsFromFmt();
-    mDevice->mBufferSize = mDevice->mUpdateSize * 4u;
+    mDevice->mBufferSize = mDevice->mUpdateSize * 8u;
 
     mStream = alcNdspOpen(mFrameStep, mDevice->mSampleRate, mDevice->mUpdateSize,
